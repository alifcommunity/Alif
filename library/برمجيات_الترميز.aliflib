
# 15
حاول:
	من برمجيات_ترميز استورد *
خلل خطأ_استيراد ك خ:
	اطلق خطأ_نظام(م"فشل تحميل برمجيات الترميز الضمنية: {خ}")





صنف الترميز:
	دالة ترميز(هذا, مدخل, اخطاء="strict"):
		اطلق خطأ_غير_منتهي
		
	دالة فك_ترميز(هذا, مدخل, اخطاء="strict"):
		اطلق خطأ_غير_منتهي

صنف مرمز_تزايدي(كائن):
	دالة __تهيئة__(هذا, اخطاء="strict"):
		هذا.اخطاء = اخطاء
		هذا.مخزن = "" # buffer
	دالة ترميز(هذا, مدخل, النهاية=خطأ):
		اطلق خطأ_غير_منتهي
		


صنف فاك_ترميز_تزايدي(كائن):
	دالة __تهيئة__(هذا, اخطاء="strict"):
		هذا.اخطاء = اخطاء
	دالة فك_ترميز(هذا, مدخل, النهاية=خطا):
		اطلق خطأ_غير_منتهي
		






صنف تدفق_الكتابة(الترميز): # 349
	دالة __تهيئة__(هذا, تدفق, اخطاء="strict"):
		هذا.تدفق = تدفق
		هذا.اخطاء = اخطاء
		
صنف تدفق_القراءة(الترميز):
	نوع_مخزن_الحرف = نص
	
	دالة __تهيئة__(هذا, تدفق, اخطاء="strict"):
		هذا.تدفق = تدفق
		هذا.اخطاء = اخطاء
		# برنامج هنا








صنف معلومات_برمجية_الترميز(مترابطة): # 83
	
	_هل_ترميز_نص = صح

	دالة __جديد__(صف, ترميز, فك_ترميز, تدفق_القراءة=عدم, تدفق_الكتابة=عدم, مرمز_تزايدي=عدم, فاك_ترميز_تزايدي=عدم, الاسم=عدم, *, _هل_ترميز_نص=عدم):
		هذا = مترابطة.__جديد__(صف, (ترميز, فك_ترميز, تدفق_القراءة, تدفق_الكتابة))
		هذا.اسم = الاسم
		هذا.ترميز = ترميز
		هذا.فك_ترميز = فك_ترميز
		هذا.مرمز_تزايدي = مرمز_تزايدي
		هذا.فاك_ترميز_تزايدي = فاك_ترميز_تزايدي
		هذا.تدفق_القراءة = تدفق_القراءة
		هذا.تدفق_الكتابة = تدفق_الكتابة
		اذا _هل_ترميز_نص هو ليس عدم:
			هذا._هل_ترميز_نص = _هل_ترميز_نص
		ارجع هذا
		
	دالة __اجلب_وسيطات_جديدة__(هذا):
		ارجع مترابطة(هذا)
