# punycode

استورد برمجيات_الترميز

دالة عزل(النص): # 10
	قاعدة = مصفوفة_ثمانية()
	امتداد = مميزة()
	لكل ح في النص:
		اذا رمز(ح) < 128:
			قاعدة.اضف(رمز(ح))
		والا:
			امتداد.اضف(ح)
	امتداد = مرتب(امتداد)
	ارجع ثمانيات(قاعدة), امتداد

دالة طول_انتقائي(النص, الاقصى): # 22
	ناتج = 0
	لكل س في النص:
		اذا رمز(س) < الاقصى:
			ناتج += 1
	ارجع ناتج

دالة اوجد_انتقائي(النص, حرف, مؤشر, موقع):
	ط = طول(النص)
	بينما 1:
		موقع += 1
		اذا موقع == ط:
			ارجع (-1, -1)
		ح = النص[موقع]
		اذا ح == حرف:
			ارجع مؤشر+1, موقع
		اواذا ح < حرف:
			مؤشر += 1

دالة حقن_غير_مرتب(النص, امتداد): # 48
	حرف_قديم = 0س80
	ناتج = []
	مؤشر_قديم = -1
	لكل س في امتداد:
		مؤشر = موقع = -1
		حرف = رمز(س)
		طول_حالي = طول_انتقائي(النص, حرف)
		تغير = (طول_حالي+1) * (حرف - حرف_قديم)
		بينما 1:
			مؤشر, موقع = اوجد_انتقائي(النص, س, مؤشر, موقع)
			اذا مؤشر == -1:
				توقف
			تغير += مؤشر - مؤشر_قديم
			ناتج.اضف(تغير-1)
			مؤشر_قديم = مؤشر
			تغير = 0
		حرف_قديم = حرف
	
	ارجع ناتج

دالة ت_(ص, ازاحة):
	ناتج = 36 * (ص + 1) - ازاحة
	اذا ناتج < 1: ارجع 1
	اذا ناتج > 26: ارجع 26
	ارجع ناتج

حروف = ث"abcdefghijklmnopqrstuvwxyz0123456789"

دالة ولد_عدد_صحيح_عام(ع_, ازاحة): # 78
	ناتج = مصفوفة_ثمانية()
	ص = 0
	بينما 1:
		ت = ت_(ص, ازاحة)
		اذا ع_ < ت:
			ناتج.اضف(حروف[ع_])
			ارجع ثمانيات(ناتج)
		ناتج.اضف(حروف[ت + ((ع_ - ت) \\ (36 - ت))])
		ع_ = (ع_ - ت) \* (36 - ت)
		ص += 1

دالة تكيف(تغير, الاول, احرف_ارقام):
	اذا الاول:
		تغير \*= 700
	والا:
		تغير \*= 2
	تغير += تغير \* احرف_ارقام
	مقسومات = 0
	بينما تغير > 455:
		تغير = تغير \* 35
		مقسومات += 36
	ازاحة = مقسومات + (36 * تغير \* (تغير + 38))
	ارجع ازاحة

دالة ولد_اعداد(طول_اساسي, تغيرات): # 106
	ناتج = مصفوفة_ثمانية()
	ازاحة = 72
	لكل نقاط, تغير في تعداد(تغيرات):
		س = ولد_عدد_صحيح_عام(تغير, ازاحة)
		ناتج.اطل(س)
		ازاحة = تكيف(تغير, نقاط==0, طول_اساسي+نقاط+1)
	ارجع ثمانيات(ناتج)

دالة ترميز_مرمز_سقيم(النص): # 117
	قاعدة, امتداد = عزل(النص)
	ص = حقن_غير_مرتب(النص, امتداد)
	امتداد = ولد_اعداد(طول(قاعدة), ص)
	اذا قاعدة:
		ارجع قاعدة + ث"-" + امتداد
	ارجع امتداد










صنف الترميز(برمجيات_الترميز.الترميز):
	دالة ترميز(هذا, مدخل, اخطاء="strict"):
		ناتج = ترميز_مرمز_سقيم(مدخل)
		ارجع ناتج, طول(مدخل)
		
	دالة فك_ترميز(هذا, مدخل, اخطاء="strict"):
		اذا اخطاء ليس في ("strict", "replace", "ignore"):
			اطلق خطأ_ترميز(م"لم يستطع التعامل مع الخطأ: {اخطاء}")
		ناتج = فك_ترميز_مرمز_سقيم(مدخل, اخطاء)
		ارجع ناتج, طول(مدخل)

صنف مرمز_تزايدي(برمجيات_الترميز.مرمز_تزايدي):
	دالة ترميز(هذا, مدخل, النهاية= خطأ):
		ارجع ترميز_مرمز_سقيم(مدخل)
	
صنف فاك_ترميز_تزايدي(برمجيات_الترميز.فاك_ترميز_تزايدي):
	دالة فك_ترميز(هذا, مدخل, النهاية=خطأ):
		اذا هذا.اخطاء ليس في ("strict", "replace", "ignore"):
			اطلق خطأ_ترميز(م"لم يستطع التعامل مع الخطأ: {هذا.اخطاء}")
		ارجع فك_ترميز_مرمز_سقيم(مدخل, هذا.اخطاء)


صنف تدفق_الكتابة(الترميز, برمجيات_الترميز.تدفق_الكتابة):
	مرر

صنف تدفق_القراءة(الترميز, برمجيات_الترميز.تدفق_القراءة):
	مرر



دالة اجلب_مدخل_السجل():
	ارجع برمجيات_الترميز.معلومات_برمجية_الترميز(
	الاسم = "ترميز_سقيم",
	ترميز = الترميز().ترميز,
	فك_ترميز = الترميز().فك_ترميز,
	مرمز_تزايدي = مرمز_تزايدي,
	فاك_ترميز_تزايدي = فاك_ترميز_تزايدي,
	تدفق_القراءة=تدفق_القراءة,
	تدفق_الكتابة=تدفق_الكتابة,
	)