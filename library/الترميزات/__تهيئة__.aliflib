استورد برمجيات_الترميز
استورد النظام

_مخبأ = {}
_غير_معروف = "--غير_معروف--"
_ذيل_استيراد = ['*']

دالة تسوية_الترميز(الترميز):
	اذا هل_نوع(الترميز, ثمانيات):
		الترميز = نص(الترميز, "ascii")
	
	احرف = []
	ترقيم = خطا
	لكل حرف في الترميز:
		اذا حرف.هل_حرف_عدد() او حرف == ".":
			اذا ترقيم و حرف:
				احرف.اضف('_')
			اذا حرف: #* ألف
				احرف.اضف(حرف)
			ترقيم = خطا
		والا:
			ترقيم = صح
	ارجع ''.اربط(احرف)



دالة دالة_البحث(الترميز):
	المدخل = _مخبأ.احضر(الترميز, _غير_معروف)
	اذا المدخل هو ليس _غير_معروف:
		ارجع المدخل
	
	ترميز_سوي = تسوية_الترميز(الترميز)
	
	# برنامج هنا
	اسماء_الوحدة = [ترميز_سوي]
	
	لكل اسم_وحدة في اسماء_الوحدة:
		اذا ليس اسم_وحدة او '.' في اسم_وحدة:
			استمر
		حاول:
			وحدة = __استورد__("الترميزات." + اسم_وحدة, من_مصفوفة=_ذيل_استيراد, مستوى=0)
		خلل خطأ_استيراد:
			مرر
		والا:
			توقف
	اذن:
		وحدة = عدم
	
	حاول:
		اجلب_مدخل_السجل = وحدة.اجلب_مدخل_السجل
	خلل خطأ_صفة:
		وحدة = عدم
		
	اذا وحدة هي عدم:
		_مخبأ[الترميز] = عدم
		ارجع عدم
		
	المدخل = اجلب_مدخل_السجل()
	اذا ليس هل_نوع(المدخل, برمجيات_الترميز.معلومات_برمجية_الترميز):
		# خطأ_هنا
		مرر
	
	_مخبأ[الترميز] = المدخل
	
	# برنامج هنا
	
	ارجع المدخل
	
برمجيات_الترميز.سجل(دالة_البحث)
	






