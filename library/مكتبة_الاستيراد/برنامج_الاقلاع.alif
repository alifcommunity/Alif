
_برنامج_الاقلاع_الخارجي = عدم

دالة _وحدة_جديدة(الاسم):
	ارجع نوع(النظام)(الاسم)



دالة _استدعي_مع_إطارات_مزالة(الدالة, *معاملات, **معاملات_مفتاحية):
	ارجع الدالة(*معاملات, **معاملات_مفتاحية)



صنف خصائص_الوحدة: # 562
	دالة __تهيئة__(هذا, الاسم, المحمل, *, الاساس=عدم, حالة_المحمل=عدم, هل_حزمة=عدم):
		هذا.اسم = الاسم
		هذا.محمل = المحمل
		هذا.اساس = الاساس
		هذا.حالة_المحمل = حالة_المحمل
		هذا.مواقع_البحث_عن_الوحدات_الفرعية = [] اذا هل_حزمة والا عدم
		هذا._وحدات_فرعية_غير_مهيئة = []
		
		هذا._اضبط_صفة_ملف = خطأ
		هذا._مخبأ = عدم
		
	@خاصية
	دالة الوالد(هذا):
		اذا هذا.مواقع_البحث_عن_الوحدات_الفرعية هي عدم:
			ارجع هذا.اسم.اقسم_ع(".")[0]
		والا:
			ارجع هذا.اسم





دالة الخصائص_من_المحمل(الاسم, المحمل, *, الاساس=عدم, هل_حزمة=عدم):
	اذا الاساس هو عدم:
		الاساس = احضر_صفة(المحمل, "_الاساس", عدم)
	
	اذا ليس الاساس و يملك_صفة(المحمل, "اجلب_اسم_الملف"):
		اذا _برنامج_الاقلاع_الخارجي هو عدم:
			اطلق خطأ_مكتبة_غير_موجودة("خطأ في الخصائص_من_المحمل") 
		الخصائص_من_موقع_الملف = _برنامج_الاقلاع_الخارجي.الخصائص_من_موقع_الملف
		
		اذا هل_حزمة هي عدم:
			ارجع الخصائص_من_موقع_الملف(الاسم, المحمل=المحمل)
		بحث = [] اذا هل_حزمة والا عدم
		ارجع الخصائص_من_موقع_الملف(الاسم, المحمل=المحمل, مواقع_البحث_عن_الوحدات_الفرعية=بحث)
	
	اذا هل_حزمة هي عدم:
		اذا يملك_صفة(المحمل, "هل_حزمة"):
			حاول:
				هل_حزمة = المحمل.هل_حزمة(الاسم)
			خلل خطأ_استيراد:
				هل_حزمة = عدم
		والا:
			هل_حزمة = خطأ
	
	ارجع خصائص_الوحدة(الاسم, المحمل, الاساس=الاساس, هل_حزمة=هل_حزمة)
		
دالة _هيئ_صفات_الوحدة(الخصائص, الوحدة, *, تجاوز=خطأ): # 733
	# __اسم__
	اذا (تجاوز او احضر_صفة(الوحدة, "__اسم__", عدم) هو عدم):
		حاول:
			الوحدة.__اسم__ = الخصائص.اسم
		خلل خطأ_صفة:
			مرر
	# __محمل__
	اذا تجاوز او احضر_صفة(الوحدة, "__محمل__", عدم) هو عدم:
		المحمل = الخصائص.محمل
		اذا المحمل هو عدم:
			_ورد.طبع("اكمل هذا الجزء") # حذف
			مرر # برنامج هنا
		حاول:
			الوحدة.__محمل__ = المحمل
		خلل خطأ_صفة:
			مرر
	# __حزمة__
	اذا تجاوز او احضر_صفة(الوحدة, "__حزمة__", عدم) هو عدم:
		حاول:
			الوحدة.__حزمة__ = الخصائص.الوالد
		خلل خطأ_صفة:
			مرر
	# __خصائص__
	حاول:
		الوحدة.__خصائص__ = الخصائص
	خلل خطأ_صفة:
		مرر
	
	# __مسار__
	اذا تجاوز او احضر_صفة(الوحدة, "__مسار__", عدم) هو عدم:
		اذا الخصائص.مواقع_البحث_عن_الوحدات_الفرعية هي ليس عدم:
			حاول:
				الوحدة.__مسار__ = الخصائص.مواقع_البحث_عن_الوحدات_الفرعية
			خلل خطأ_صفة:
				مرر
	
	ارجع الوحدة

دالة وحدة_من_الخصائص(الخصائص): # 806
	الوحدة = عدم
	اذا يملك_صفة(الخصائص.محمل, "انشئ_وحدة"):
		الوحدة = الخصائص.محمل.انشئ_وحدة(الخصائص)
	اواذا يملك_صفة(الخصائص.محمل, "نفذ_الوحدة"):
		اطلق خطأ_استيراد("المحملات التي تمتلك وظيفة نفذ_الوحدة() يجب أن تمتلك وظيفة انشئ_وحدة()")
	اذا الوحدة هي عدم:
		الوحدة = _وحدة_جديدة(الخصائص.اسم)
	_هيئ_صفات_الوحدة(الخصائص, الوحدة)
	ارجع الوحدة


دالة _حمل_غير_مقفول(الخصائص):
	# برنامج هنا
	الوحدة = وحدة_من_الخصائص(الخصائص)
	
	الخصائص._تهيئة = صح
	حاول:
		النظام.وحدات[الخصائص.اسم] = الوحدة
		حاول:
			اذا الخصائص.محمل هو عدم:
				اطلق خطأ_استيراد("محمل مفقود", اسم=الخصائص.اسم)
				مرر # برنامج هنا
			والا:
				الخصائص.محمل.نفذ_الوحدة(الوحدة)
		خلل:
			حاول:
				احذف النظام.وحدات[الخصائص.اسم]
			خلل خطأ_مفتاح:
				مرر
			اطلق
		
		الوحدة = النظام.وحدات.اسحب(الخصائص.اسم) 
		النظام.وحدات[الخصائص.اسم] = الوحدة
	نهاية:
		الخصائص._تهيئة = خطأ
		
	ارجع الوحدة
	

# المحملات #####################################################
صنف مستورد_الضمنيات:
	
	_الاساس = "ضمني"
	
	@وظيفة_صنف
	دالة اوجد_الخصائص(صف, كامل_الاسم, المسار=عدم, الهدف=عدم):
		اذا _ورد.هل_ضمني(كامل_الاسم):
			ارجع الخصائص_من_المحمل(كامل_الاسم, صف, الاساس=صف._الاساس)
		والا:
			ارجع عدم
	
	@وظيفة_ساكنة
	دالة انشئ_وحدة(الخصائص):
		اذا الخصائص.اسم ليس في النظام.اسماء_الوحدات_الضمنية:
			اطلق خطأ_استيراد(م"{الخصائص.اسم} ليس وحدة ضمنية") # مراجعة
		ارجع _استدعي_مع_إطارات_مزالة(_ورد.انشئ_ضمني, الخصائص)	
				
	
	@وظيفة_ساكنة
	دالة نفذ_الوحدة(الوحدة):
		_استدعي_مع_إطارات_مزالة(_ورد.نفذ_ضمني, الوحدة)

صنف مستورد_المجردات:
	_الاساس = "مجرد"
	
	@وظيفة_صنف
	دالة اوجد_الخصائص(صف, كامل_الاسم, المسار=عدم, الهدف=عدم):
		معلومات = _استدعي_مع_إطارات_مزالة(_ورد.اوجد_مصرف, كامل_الاسم)
		اذا معلومات هي عدم:
			ارجع عدم
		
		_, هل_حزمة, الاسم_الاصل = معلومات
		الخصائص = الخصائص_من_المحمل(كامل_الاسم, صف, الاساس=صف._الاساس, هل_حزمة = هل_حزمة)
		
		# برنامج هنا
		
		ارجع الخصائص
	
	@وظيفة_ساكنة
	دالة انشئ_وحدة(الخصائص):
		الوحدة = _وحدة_جديدة(الخصائص.اسم)
		# برنامج هنا
		ارجع الوحدة
		
	@وظيفة_ساكنة
	دالة نفذ_الوحدة(الوحدة):
		الخصائص = الوحدة.__خصائص__
		الاسم = الخصائص.اسم
		الشيفرة = _استدعي_مع_إطارات_مزالة(_ورد.اجلب_كائن_مصرف, الاسم)
		نفذ(الشيفرة, الوحدة.__فهرس__)





دالة _اوجد_الخصائص(الاسم, المسار, الهدف=عدم):
	مسار_التعريف = النظام.مسار_التعريف
	اذا مسار_التعريف هو عدم:
		اطلق خطأ_استيراد("النظام.مسار_التعريف قيمته فارغة, سيتم إغلاق ألف")
	
	اذا ليس مسار_التعريف:
		_ورد.طبع("ليس مسار_التعريف")
		مرر # تحذير هنا
	
	هل_إعادة_تحميل = الاسم في النظام.وحدات
	لكل موجد في مسار_التعريف:
		حاول:
			اوجد_الخصائص = موجد.اوجد_الخصائص
		خلل خطأ_صفة:
			استمر
		والا:
			الخصائص = اوجد_الخصائص(الاسم, المسار, الهدف)
		اذا الخصائص هي ليس عدم:
			اذا ليس هل_إعادة_تحميل و الاسم في النظام.وحدات:
				الوحدة = النظام.وحدات[الاسم]
				حاول:
					__خصائص__ = الوحدة.__خصائص__
				خلل خطأ_صفة:
					ارجع الخصائص
				والا:
					اذا __خصائص__ هي عدم:
						ارجع الخصائص
					والا:
						ارجع __خصائص__
			والا:
				ارجع الخصائص
	اذن:
		ارجع عدم
			

دالة _اوجد_وحمل_غير_مقفل(الاسم, استيراد_):
	المسار = عدم
	الوالد = الاسم.اقسم_ع(".")[0]
	خصائص_الوالد = عدم
	اذا الوالد:
		اذا الوالد ليس في النظام.وحدات:
			_استدعي_مع_إطارات_مزالة(استيراد_, الوالد)
		اذا الاسم في النظام.وحدات:
			ارجع النظام.وحدات[الاسم]
		وحدة_الوالد = النظام.وحدات[الوالد]
		حاول:
			المسار = وحدة_الوالد.__مسار__
		خلل خطأ_صفة:
			رسالة = م"{الاسم}, {الوالد} ليس حزمة"
			اطلق خطأ_مكتبة_غير_موجودة(رسالة, اسم=الاسم) من عدم
		خصائص_الوالد = وحدة_الوالد.__خصائص__
		الطفل = الاسم.اقسم_ع(".")[2]
	الخصائص = _اوجد_الخصائص(الاسم, المسار)
	اذا الخصائص هي عدم:
		اطلق خطأ_مكتبة_غير_موجودة(م"لا يوجد وحدة باسم {الاسم}", اسم=الاسم)
	والا:
		اذا خصائص_الوالد:
			خصائص_الوالد._وحدات_فرعية_غير_مهيئة.اضف(الطفل)
		حاول:
			الوحدة = _حمل_غير_مقفول(الخصائص)
		نهاية:
			اذا خصائص_الوالد:
				خصائص_الوالد._وحدات_فرعية_غير_مهيئة.اسحب()
	اذا الوالد:
		وحدة_الوالد = النظام.وحدات[الوالد]
		حاول:
			اضف_صفة(وحدة_الوالد, الطفل, الوحدة)
		خلل خطأ_صفة:
			_ورد.طبع("حصل خطأ هنا")
	
	ارجع الوحدة

	
_يحتاج_تحميل = كائن()

دالة _اوجد_وحمل(الاسم, استيراد_):
	الوحدة = النظام.وحدات.احضر(الاسم, _يحتاج_تحميل)
	اذا (الوحدة هي _يحتاج_تحميل او احضر_صفة(احضر_صفة(الوحدة, "__خصائص__", عدم), "_جاري_التهيئة", خطا)):
		ارجع _اوجد_وحمل_غير_مقفل(الاسم, استيراد_)
	
	ارجع الوحدة

دالة _تعامل_من_القائمة(الوحدة, من_القائمة, استورد_, *, تداخل=خطأ):
	لكل س في من_القائمة:
		اذا ليس هل_نوع(س, نص):
			_ورد.طبع("حالة غير مكتملة السطر قرب 268")
		اواذا س == "*":
			_ورد.طبع("حالة غير مكتملة السطر قرب 270")
		اواذا ليس يملك_صفة(الوحدة, س):
			من_اسم = م"{الوحدة.__اسم__}.{س}"
			حاول:
				_استدعي_مع_إطارات_مزالة(استورد_, من_اسم)
			خلل خطأ_مكتبة_غير_موجودة ك خ:
				اذا (خ.اسم == من_اسم و النظام.وحدات.احضر(من_اسم, _يحتاج_تحميل) هو ليس عدم):
					استمر
				اطلق
	
	ارجع الوحدة

دالة _اضبط(وحدة_نظام, _وحدة_ورد):
	عام _ورد, النظام
	_ورد = _وحدة_ورد
	النظام = وحدة_نظام

