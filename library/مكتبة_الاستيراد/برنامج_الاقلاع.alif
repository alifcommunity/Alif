دالة _ثبت(وحدة_نظام, _وحدة_ورد):
	_اضبط(وحدة_نظام, _وحدة_ورد)
	
	النظام.مسار_التعريف.اضف(مستورد_الضمنيات)
	النظام.مسار_التعريف.اضف(مستورد_المجردات)
	
دالة _ثبت_مستوردات_الخارج():
	عام _برنامج_الاقلاع_الخارجي
	استورد _مكتبة_استيراد_خارجي_مصرفة
	_برنامج_الاقلاع_الخارجي = _مكتبة_استيراد_خارجي_مصرفة
	_مكتبة_استيراد_خارجي_مصرفة._ثبت(النظام.وحدات[__اسم__])
