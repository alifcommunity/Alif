# 558
_عامي = كائن()

دالة الخصائص_من_موقع_الملف(الاسم, الموقع=عدم, *, المحمل=عدم, مواقع_البحث_عن_الوحدات_الفرعية=_عامي):
	اذا الموقع هو عدم:
		الموقع = '<غير_معرف>'
		اذا يملك_صفة(المحمل, "اجلب_اسم_الملف"):
			حاول:
				الموقع = المحمل.اجلب_اسم_الملف(الاسم)
			خلل خطأ_استيراد:
				مرر
		والا:
			_ورد.طبع("رمز:99")
			مرر
			
	الخصائص = _برنامج_الاقلاع.خصائص_الوحدة(الاسم, المحمل, الاساس=الموقع)
	الخصائص._اضبط_صفة_ملف = صح
	
	اذا المحمل هو عدم:
		لكل صنف_محمل, لاحقات في _اجلب_محملات_الملف_المدعومة():
			اذا الموقع.ينتهي_ب(مترابطة(لاحقات)):
				المحمل = صنف_محمل(الاسم, الموقع)
				الخصائص.محمل = المحمل
				توقف
		اذن:
			ارجع عدم
		
	اذا مواقع_البحث_عن_الوحدات_الفرعية هي _عامي:
		_ورد.طبع("لم يتم العمل على هذه الحالة بعد")
	والا:
		الخصائص.مواقع_البحث_عن_الوحدات_الفرعية = مواقع_البحث_عن_الوحدات_الفرعية
	اذا الخصائص.مواقع_البحث_عن_الوحدات_الفرعية == []:
		اذا الموقع:
			_ورد.طبع("لم يتم العمل على هذه الحالة بعد")
			اسم_المجلد = _المسار_افصل(الموقع)[0]
			الخصائص.مواقع_البحث_عن_الوحدات_الفرعية.اضف(اسم_المجلد)

	ارجع الخصائص


صنف _محمل_اساسي: # 734
	دالة هل_حزمة(هذا, كامل_الاسم):
		اسم_الملف = _المسار_افصل(هذا.اجلب_اسم_الملف(كامل_الاسم))[1]
		اسم_الملف_الاساس = اسم_الملف.افصل_ع(".", 1)[0]
		اسم_ذيل = كامل_الاسم.اقسم_ع(".")[2]
		ارجع اسم_الملف_الاساس == "__تهيئة__" و اسم_ذيل != "__تهيئة__"

	دالة انشئ_وحدة(هذا, الخصائص):
		""" استخدم الدلالات الافتراضية لإنشاء الوحدة """
	
	دالة نفذ_الوحدة(هذا, الوحدة):
		الشيفرة = هذا.اجلب_الشيفرة(الوحدة.__اسم__) # تابع من هنا 3
		اذا الشيفرة هي عدم:
			اطلق خطأ_استيراد(م"لا يمكن تحميل الوحدة {الوحدة.__اسم__} عندما اجلب_الشيفرة() يرجع عدم")
		_برنامج_الاقلاع._استدعي_مع_إطارات_مزالة(نفذ, الشيفرة, الوحدة.__فهرس__)


صنف محمل_مصدر(_محمل_اساسي): # 764
	
	دالة مصدر_لشيفرة(هذا, البيانات, المسار, *, _محسن=-1):
		ارجع _برنامج_الاقلاع._استدعي_مع_إطارات_مزالة(ترجم, البيانات, المسار, "نفذ", لا_ترث=صح, محسن=_محسن)
	
	دالة اجلب_الشيفرة(هذا, كامل_الاسم):
		مسار_المصدر = هذا.اجلب_اسم_الملف(كامل_الاسم)
		بايتات_المصدر = عدم
		
		# برنامج هنا
		
		اذا بايتات_المصدر هي عدم:
			بايتات_المصدر = هذا.اجلب_البيانات(مسار_المصدر)
		كائن_شيفرة = هذا.مصدر_لشيفرة(بايتات_المصدر, مسار_المصدر)
		
		ارجع كائن_شيفرة


صنف محمل_ملف: # 909
	دالة __تهيئة__(هذا, كامل_الاسم, المسار):
		هذا.اسم = كامل_الاسم
		هذا.مسار = المسار
	
	# @_تفقد_الاسم
	دالة اجلب_اسم_الملف(هذا, كامل_الاسم):
		ارجع هذا.مسار
		
	دالة اجلب_البيانات(هذا, المسار):
		اذا هل_نوع(هذا, (محمل_مصدر, محمل_ملف_امتداد)):
			عند تبادل.افتح_الشيفرة(نص(المسار)) ك ملف:
				ارجع ملف.اقرا()
		والا:
			عند تبادل.ملف(المسار, "ق") ك ملف:
				ارجع ملف.اقرا()


صنف محمل_ملف_مصدري(محمل_ملف, محمل_مصدر): # 959
	مرر

صنف محمل_ملف_امتداد(محمل_ملف, _محمل_اساسي): # 1029
	دالة __تهيئة__(هذا, الاسم, المسار):
		هذا.اسم = الاسم
		هذا.مسار = المسار
		
	دالة انشئ_وحدة(هذا, الخصائص):
