اذا _ويندوز: # 100
	دالة _المسار_ربط(*اجزاء_المسار):
		اذا ليس اجزاء_المسار:
			ارجع ""
		اذا طول(اجزاء_المسار) == 1:
			ارجع اجزاء_المسار[0]
		الجذر = ""
		المسار = []
		لكل جذر_جديد, ذيل في طبق(_نظام_التشغيل._المسار_افصل_الجذر, اجزاء_المسار):
			اذا جذر_جديد.يبدا_ب(مترابطة_فواصل_المسار) او جذر_جديد.ينتهي_ب(مترابطة_فواصل_المسار) :
				الجذر = جذر_جديد.جرد_يمين(فواصل_المسار) او الجذر
				المسار = [فاصل_المسار + ذيل]
			اواذا جذر_جديد.ينتهي_ب(":"):
				اذا الجذر.طي_الحالة() != جذر_جديد.طي_الحالة():
					الجذر = جذر_جديد
					المسار = [ذيل]
				والا:
					المسار.اضف(ذيل)
			والا:
				الجذر = جذر_جديد او الجذر
				المسار.اضف(ذيل)
		المسار = [جزء.جرد_يمين(فواصل_المسار) لكل جزء في المسار اذا جزء]
		اذا طول(المسار) == 1 و ليس المسار[0]:
			ارجع الجذر + فاصل_المسار
		ارجع الجذر + فاصل_المسار.اربط(المسار)
والا:
	دالة _المسار_ربط(*اجزاء_المسار):
		ارجع فاصل_المسار.اربط([جزء.جرد_يمين(فواصل_المسار) لكل جزء في اجزاء_المسار اذا جزء])

دالة _المسار_الحالة(المسار): # 145
	ارجع _نظام_التشغيل.حالة(المسار)

