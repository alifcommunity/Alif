# تغليف الدوال بدوال أخرى
حالة_المستخدم = {"هل_متصل": خطا}

دالة طلب_دخول(عنصر):
	دالة تغليف(*معاملات, **معاملات_مفتاحية):
		اذا ليس حالة_المستخدم["هل_متصل"]:
			اطبع("لا يسمح بالدخول: يجب تسجيل الدخول أولاً")
			ارجع عدم
		ارجع عنصر(*معاملات, **معاملات_مفتاحية)
	ارجع تغليف

