# تعريف صنف
صنف مخروط_علوي:
	دالة __تهيئة__(هذا, نق = 1, ع = 1):	
		هذا.نق_القاعدة = نق
		هذا.الارتفاع = ع
		هذا.بي = 3.14

	دالة مساحة_القاعدة(هذا):
		م_القاعدة = 2 * هذا.بي * هذا.نق_القاعدة * هذا.الارتفاع
		ارجع م_القاعدة
	
	دالة حجم_المخروط(هذا):
		ارجع هذا.مساحة_القاعدة() * هذا.الارتفاع \ 3
	
صنف مخروط_سفلي:
	دالة __تهيئة__(هذا, نق = 1, ع = 1, مخروط_ع = عدم):	
		هذا.نق_القاعدة = نق
		هذا.الارتفاع = ع
		هذا.بي = 3.14
		هذا.مخروط_ع = مخروط_ع
	
	دالة مساحة_القاعدة(هذا):
		م_القاعدة = 2 * هذا.بي * هذا.نق_القاعدة * هذا.الارتفاع
		ارجع م_القاعدة

	دالة حجم_المخروط(هذا):
		ارجع هذا.مساحة_القاعدة() * هذا.الارتفاع \ 3

	دالة مح_المخروطين(هذا):
		ارجع هذا.حجم_المخروط() + هذا.مخروط_ع.حجم_المخروط()


مخروط_ع = مخروط_علوي(2, 2)
مخروط_س = مخروط_سفلي(3, 4, مخروط_ع)

ح_المخاريط= مخروط_س.مح_المخروطين()

اطبع(مخروط_ع.حجم_المخروط(), مخروط_س.حجم_المخروط(), ح_المخاريط)

# الوراثة
صنف انسان:
	دالة __تهيئة__(هذا, عمر):
		هذا.العمر = عمر

صنف شخص(انسان):
	دالة __تهيئة__(هذا, عمر, طول):
		اصل().__تهيئة__(عمر)
		هذا.الطول = طول
	
	دالة __عرض__(هذا):
		ارجع م"الطول: {هذا.الطول}, العمر: {هذا.العمر}"

الشخص = شخص(40, 180)
اطبع(الشخص)

صنف انسان:
	دالة __تهيئة__(هذا, عمر):
		هذا.العمر = عمر

صنف انسان2:
	دالة __تهيئة__(هذا, وزن):
		هذا.الوزن = وزن

صنف شخص(انسان, انسان2):
	دالة __تهيئة__(هذا, عمر, طول, وزن):
		انسان.__تهيئة__(هذا, عمر)
		انسان2.__تهيئة__(هذا, وزن)
		هذا.الطول = طول

	دالة __استدعاء__(هذا, سرعة):
		هذا.السرعة = سرعة

	دالة __عرض__(هذا):
		ارجع م"العمر: {هذا.العمر}, الوزن: {هذا.الوزن}, الطول: {هذا.الطول}, السرعة: {هذا.السرعة}"

الشخص = شخص(40, 180, 75)
الشخص("سريع")
اطبع(الشخص)

صنف وزن:
	دالة __تهيئة__(هذا, كيلو):
		هذا.الكيلو = كيلو
	دالة __اجمع__(هذا, اخر):
		ارجع وزن(اخر + هذا.الكيلو)
	دالة __اجمع_ع__(هذا, اخر):
		ارجع وزن(هذا.الكيلو + اخر)
	دالة __عرض__(هذا):
		ارجع م"{هذا.الكيلو} كيلوغرام"

الوزن = وزن(50)
مجموع_الوزن1 = الوزن + 60
مجموع_الوزن2 = 30 + الوزن
اطبع(مجموع_الوزن1, مجموع_الوزن2, الفاصل=", ", النهاية=".\س")

صنف سيارة:
	الزمن = 5
	دالة __تهيئة__(هذا):
		هذا.اللون = "ابيض"

	دالة اطبع_اللون(هذا, اللون):
		هذا.اللون = اللون
		اطبع(م"لون السيارة اصبح {هذا.اللون}")

	@وظيفة_صنف
	دالة التسارع(صف, السرعة):
		ارجع السرعة * صف.الزمن
		
	@وظيفة_ساكنة
	دالة حساب_العمر_بالسنة(سنة_الصنع):
		ارجع م"{2027 - سنة_الصنع} سنة"

بي_إم = سيارة()
بي_إم.اطبع_اللون("اسود")
اطبع(سيارة.التسارع(10))
اطبع(سيارة.حساب_العمر_بالسنة(1995))

صنف سيارة(مترابطة):
	دالة __جديد__(صف, السرعة_القصوى):
		هذا = مترابطة.__جديد__(صف, السرعة_القصوى)
		هذا.السرعة_القصوى = السرعة_القصوى
		ارجع هذا

	دالة __عرض__(هذا):
		ارجع م"السرعة: {هذا.السرعة_القصوى}"
نيسان = سيارة((240, 260))
اطبع(نيسان)
اطبع(طول(نيسان))


