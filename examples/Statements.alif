صنف مسجل_المسافة_البادئة:
	المستوى = 0
	دالة __تهيئة__(هذا, اسم_الخطوة):
		هذا.اسم_الخطوة = اسم_الخطوة
	دالة __ادخل__(هذا): # لا تحتاج تمرير أي معاملات إجبارية
		المسافة_البادئة = " " * مسجل_المسافة_البادئة.المستوى
		اطبع(م"{المسافة_البادئة}-> بداية: {هذا.اسم_الخطوة}")
		مسجل_المسافة_البادئة.المستوى += 1
	دالة __اخرج__(هذا, نوع_الخلل, قيمة_الخلل, تتبع_الخلل): # تحتاج اربع معاملات إجبارية
		مسجل_المسافة_البادئة.المستوى -= 1
		المسافة_البادئة = " " * مسجل_المسافة_البادئة.المستوى
		اطبع(م"{المسافة_البادئة}✓ إنتهى: {هذا.اسم_الخطوة}")
		ارجع خطا

