دالة معادلة_تربيعية(أ, ب, ج):
	المميز = ب ^ 2 - 4 * أ * ج
	اذا المميز  > 0:
		الجذر1 = (-ب + المميز ^ 0.5) \ (2*أ)
		الجذر2 = (-ب - المميز ^ 0.5) \ (2*أ)
		ارجع الجذر1, الجذر2
	اواذا المميز == 0:
		الجذر = -ب \ (2 * أ)
		ارجع الجذر
	والا:
		ارجع "لا يوجد جذر حقيقي -الجذر تخيلي-"

اطبع("""*- هذا البرنامج يقوم بحساب جذور المعادلة التربيعية -*
المعادلة بالشكل التالي: أ*س² + ب*س + ج""")

بينما صح:
	حاول:
		أ = عشري(ادخل("قيمة أ: "))
		ب = عشري(ادخل("قيمة ب: "))
		ج = عشري(ادخل("قيمة ج: "))
		توقف
	خلل خطأ_قيمة:
		اطبع("يمكن إدخال اعداد فقط")

الجذور = معادلة_تربيعية(أ, ب, ج)

اطبع(م"جذور المعادلة التربيعية: { الجذور } ")